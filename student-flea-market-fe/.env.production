# Public build-time values for production (`next build`). Committed on purpose:
# NEXT_PUBLIC_* values are embedded in the JavaScript sent to every browser, so they are not secrets.
# Never put secrets here. A Vercel Environment Variable with the same name overrides this file.

# Google Identity Services - OAuth 2.0 Web client ID (the client secret is NOT used by the frontend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=90108792424-113fvmi319t7i262ebh3q6ssbkl628fh.apps.googleusercontent.com

# REST API through CloudFront + AWS WAF (path /api/* of the media distribution).
NEXT_PUBLIC_API_URL=https://d10q7kj8cz6ohq.cloudfront.net/api
# SignalR hub stays on API Gateway directly (CloudFront only routes /api/* to the API).
NEXT_PUBLIC_HUB_URL=https://fjwdtcppob.execute-api.ap-southeast-1.amazonaws.com/hubs/chat
